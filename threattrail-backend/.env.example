# ── ThreatTrail Environment Configuration Template ────────────────────────────

# Database Connection (defaults to local SQLite if unset)
# For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg://admin:admin@localhost:5432/threattrail

# JWT Secret Key (generate a strong, high-entropy key for production)
# e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=threattrail-soc-jwt-secret-key-2026

# Allowed CORS Origins (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
