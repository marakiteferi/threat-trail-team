# ==============================================================================
# ThreatTrail - Environment Configuration Template
# Copy this file to .env and replace placeholder values before running.
# ==============================================================================

# Backend Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/threattrail

# Authentication & Security (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=REPLACE_WITH_32_BYTE_HEX_SECRET_KEY_BEFORE_RUNNING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Demo Seed Accounts (Used only by seed.py; rotate if exposed on a shared network)
DEMO_ANALYST_USERNAME=analyst
DEMO_ANALYST_PASSWORD=ChangeMeAnalyst!2026
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=ChangeMeAdmin!2026

# Server & CORS
PORT=5050
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_BYTES=10485760

# Frontend (Vite)
VITE_API_URL=http://localhost:5050/api
VITE_ENABLE_DEMO_HELPER=true
